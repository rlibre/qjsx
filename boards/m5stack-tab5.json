    "pwm": { "outputs": 8, "timers": 4, "clock": 80000000, "maxBits": 14 },
    "spi": { "ports": [2, 3], "reserved": [0, 1] },
    "natives": ["sys/fs", "sys/crypto", "sys/draw", "device/board", "device/gpio", "device/rmt", "device/usb", "device/i2c", "device/spi", "device/adc", "device/pwm", "device/serial"],
    "parts": [
        { "id": "reset", "model": "button", "label": "RESET", "reset": true },
        { "id": "screen", "model": "ili9881c-720x1280", "label": "Screen", "backlight": 22 },
        { "id": "touch", "model": "gt911", "label": "Touch", "i2c": { "sda": 31, "scl": 32 }, "address": "0x14",
          "interrupt": 23, "screen": "screen", "range": [720, 1280], "points": 10 }
    ]
}
