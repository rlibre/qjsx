+
+int JS_DebugSetSlot(JSContext *ctx, int level, JSDebugSlotKind kind, int index, JSValue value)
+{
+    JSValue *slot = js_debug_slot(ctx, level, kind, index);
+
+    if (slot == NULL) {
+        JS_FreeValue(ctx, value);
+        return -1;
+    }
+    set_value(ctx, slot, value);
+    return 0;
+}
