+        fd->scopes[scope].source_start = s->token.ptr - s->buf_start;
+        fd->scopes[scope].source_end = -1;
         emit_op(s, OP_enter_scope);
         emit_u16(s, scope);
         return fd->scope_level = scope;
@@ -351,6 +369,8 @@
